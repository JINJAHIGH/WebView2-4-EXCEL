VERSION 1.0 CLASS
BEGIN
  MultiUse = -1
END
Attribute VB_Name = "mod_WV2_ブラウザー環境"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Option Explicit

Public Enum 環境初期化状態
    環境作成済み = 0
    環境準備待機中 = 1
    環境準備済み = 2
    環境初期化失敗 = 3
End Enum

Private 保持ハンドラー      As mod_WV2_COM通知ハンドラー
Private 保持ポインター環境 As LongPtr
Private 保持状態        As 環境初期化状態
Private 保持最終エラー    As Long

' =========================================================================
' 処理概要       : インスタンスの内部状態を初期化
' =========================================================================
Private Sub Class_Initialize()
    保持状態 = 環境作成済み
    保持ポインター環境 = 0
    保持最終エラー = 0
End Sub

' =========================================================================
' 処理概要       : 保持するリソースと参照を解放
' =========================================================================
Private Sub Class_Terminate()
    If 保持ポインター環境 <> 0 Then
    
        COM参照解放 保持ポインター環境
        保持ポインター環境 = 0
    End If
    
    If Not (保持ハンドラー Is Nothing) Then
    
        Set 保持ハンドラー = Nothing
    End If
End Sub

' =========================================================================
' 処理概要       : WebView2環境の非同期生成を開始
' 引数           : ユーザーデータパス (String) - WebView2プロファイルの保存先
' =========================================================================
Public Sub 初期化(ByVal ユーザーデータパス As String)
    Dim 仮想COMオブジェクト As LongPtr
    Dim パス As String
    Dim 実行結果 As Long
    
    If 保持状態 <> 環境作成済み Then
        MsgBox "ブラウザー環境.Init は二重呼び出し不可", vbCritical
        Exit Sub
    End If
    
    Set 保持ハンドラー = 通知先を設定したCOMコールバックハンドラーを取得(環境生成完了通知, Me)
    If 保持ハンドラー Is Nothing Then
        MsgBox "ブラウザー環境.Init: ハンドラの Acquire に失敗", vbCritical
        保持状態 = 環境初期化失敗
        Exit Sub
    End If
    
    仮想COMオブジェクト = 保持ハンドラー.スロットアドレス + 仮想COMオブジェクト位置
    
    パス = ユーザーデータパス
    If LenB(パス) = 0 Then パス = mod_WV2_共通設定.プロファイル保存先
    
    ' WebView2プロファイルの保存先を準備する
    必要な保存先フォルダーを作成 パス
    
    保持状態 = 環境準備待機中
    
    ' WebView2環境の作成を要求し、結果は完了通知で受け取る
    実行結果 = WebView2環境生成API(0, StrPtr(パス), 0, 仮想COMオブジェクト)
    
    If 実行結果 <> 0 Then
        MsgBox "CreateCoreWebView2EnvironmentWithOptions failed. HRESULT: &H" & Hex(実行結果), vbCritical
        保持状態 = 環境初期化失敗
        保持最終エラー = 実行結果
        
        Exit Sub
    End If
End Sub

' =========================================================================
' 処理概要       : 環境の生成結果を保持して初期化状態を更新
' 引数           : エラーコード (Long) - 非同期処理のHRESULT
'                  ポインター環境 (LongPtr) - 生成された環境のポインター
' =========================================================================
Public Sub 環境の生成結果を保持して初期化状態を更新(ByVal エラーコード As Long, ByVal ポインター環境 As LongPtr)
    保持最終エラー = エラーコード
    
    If エラーコード = 0 And ポインター環境 <> 0 Then
    
        保持ポインター環境 = ポインター環境
        COM参照追加 保持ポインター環境
        保持状態 = 環境準備済み
    Else
        保持ポインター環境 = 0
        保持状態 = 環境初期化失敗
    End If
    
    Set 保持ハンドラー = Nothing
End Sub

' =========================================================================
' 処理概要       : 初期化処理の状態を取得
' 戻り値         : 環境初期化状態 - 初期化処理の状態
' =========================================================================
Public Property Get 状態() As 環境初期化状態
    状態 = 保持状態
End Property

' =========================================================================
' 処理概要       : 初期化が完了して利用できるか判定
' 戻り値         : Boolean - 初期化完了時 True
' =========================================================================
Public Property Get 利用可能() As Boolean
    利用可能 = (保持状態 = 環境準備済み)
End Property

' =========================================================================
' 処理概要       : 初期化が失敗したか判定
' 戻り値         : Boolean - 初期化失敗時 True
' =========================================================================
Public Property Get 初期化失敗() As Boolean
    初期化失敗 = (保持状態 = 環境初期化失敗)
End Property

' =========================================================================
' 処理概要       : 直前の処理で発生したエラーを取得
' 戻り値         : Long - 直前の処理で発生したエラー
' =========================================================================
Public Property Get 最終エラー() As Long
    最終エラー = 保持最終エラー
End Property

' =========================================================================
' 処理概要       : WebView2環境のインターフェースポインターを取得
' 戻り値         : LongPtr - 対象のアドレス。取得できない場合 0
' =========================================================================
Public Property Get 環境ポインター() As LongPtr
    環境ポインター = 保持ポインター環境
End Property
