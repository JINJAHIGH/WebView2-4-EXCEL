Attribute VB_Name = "mod_WV2_ログ管理"
Option Explicit

' -------------
' ログ設定
' -------------
Public Const エラーログ          As Long = 1
Public Const 警告ログ            As Long = 2
Public Const 情報ログ            As Long = 3
Public Const 詳細ログ            As Long = 4
Private Const ログ保持数         As Long = 20
Private Const ログファイル接頭辞 As String = "wv2_"

Private Type 日時情報
    年 As Integer
    月 As Integer
    曜日 As Integer
    日 As Integer
    時 As Integer
    分 As Integer
    秒 As Integer
    ミリ秒 As Integer
End Type

Private Declare PtrSafe Sub 現在時刻取得API Lib "kernel32" Alias "GetLocalTime" (ByRef 日時出力先 As 日時情報)

Private 保持ログ番号 As Long
Private 保持ログパス As String
Private 保持ログレベル As Long
Private 保持ログ階層数 As Long
Private 保持ログ待機中 As String
Private 保持ログ連番 As Long
Private 保持ログ初期化 As Boolean

' =========================================================================
' 処理概要       : エラーレベルのログを記録
' 引数           : ログメッセージ (String) - ログに記録する内容
' =========================================================================
Public Sub エラーレベルのログを記録(ByVal ログメッセージ As String)
    ログに時刻とレベルを付加してファイルへ記録 エラーログ, ログメッセージ
End Sub

' =========================================================================
' 処理概要       : 警告レベルのログを記録
' 引数           : ログメッセージ (String) - ログに記録する内容
' =========================================================================
Public Sub 警告レベルのログを記録(ByVal ログメッセージ As String)
    ログに時刻とレベルを付加してファイルへ記録 警告ログ, ログメッセージ
End Sub

' =========================================================================
' 処理概要       : 情報レベルのログを記録
' 引数           : ログメッセージ (String) - ログに記録する内容
' =========================================================================
Public Sub 情報レベルのログを記録(ByVal ログメッセージ As String)
    ログに時刻とレベルを付加してファイルへ記録 情報ログ, ログメッセージ
End Sub

' =========================================================================
' 処理概要       : 詳細レベルのログを記録
' 引数           : ログメッセージ (String) - ログに記録する内容
' =========================================================================
Public Sub 詳細レベルのログを記録(ByVal ログメッセージ As String)
    ログに時刻とレベルを付加してファイルへ記録 詳細ログ, ログメッセージ
End Sub

' =========================================================================
' 処理概要       : 現在のログファイルのパスを取得
' 戻り値         : String - 現在のログファイルのパス
' =========================================================================
Public Property Get ログファイルパス() As String
    ログファイルパス = 保持ログパス
End Property

' =========================================================================
' 処理概要       : ログを記録するレベルを取得
' 戻り値         : Long - ログを記録するレベル
' =========================================================================
Public Property Get ログ出力レベル() As Long
    If Not 保持ログ初期化 Then ログ設定の既定値を初期化
    ログ出力レベル = 保持ログレベル
End Property

' =========================================================================
' 処理概要       : ログを記録するレベルを設定
' 引数           : ログ引数 (Long) - 設定するログレベル
' =========================================================================
Public Property Let ログ出力レベル(ByVal ログ引数 As Long)
    If Not 保持ログ初期化 Then ログ設定の既定値を初期化
    If ログ引数 < エラーログ Then
        保持ログレベル = エラーログ
    ElseIf ログ引数 > 詳細ログ Then
        保持ログレベル = 警告ログ
    Else
        保持ログレベル = ログ引数
    End If
End Property

' =========================================================================
' 処理概要       : ログ設定の既定値を初期化
' =========================================================================
Private Sub ログ設定の既定値を初期化()
    If 保持ログ初期化 Then Exit Sub
    
    保持ログ初期化 = True
    保持ログレベル = 警告ログ
    保持ログ連番 = 0
    保持ログ階層数 = 0
    保持ログ待機中 = ""
End Sub

' =========================================================================
' 処理概要       : 新しいログファイルを開く
' =========================================================================
Public Sub 新しいログファイルを開く()
    Dim ログフォルダー As String
    Dim ログ先頭 As String
    
    On Error Resume Next
    ログファイルを閉じる
    On Error GoTo 0
    
    ログ設定の既定値を初期化
    保持ログ連番 = 0
    
    ログフォルダー = ログ保存先フォルダーを作成してパスを取得()
    If Len(ログフォルダー) = 0 Then Exit Sub
    
    保持件数を超えた古いログファイルを削除 ログフォルダー
    
    保持ログパス = ログフォルダー & ログファイル接頭辞 & Format$(Now, "yyyymmdd_hhnnss") & ".log"
    
    On Error GoTo ErrorHanler
    保持ログ番号 = FreeFile
    Open 保持ログパス For Binary Access Write Shared As #保持ログ番号
    Seek #保持ログ番号, LOF(保持ログ番号) + 1
    
    ログ先頭 = "=== ログ管理 開始 " & Format$(Now, "yyyy-mm-dd hh:nn:ss") & " ===" & vbCrLf & "=== path = " & 保持ログパス & " ===" & vbCrLf & "=== 行頭の 6 桁は連番。欠番があればログが落ちている ===" & vbCrLf
    バイト配列をログファイルへ書き込み 文字列をUTF8のバイト配列へ変換(ログ先頭)
    
    Exit Sub
    
ErrorHanler:
    MsgBox "処理を完了できません。" & vbCrLf & Err.Description, vbExclamation, "ログ開始"
    
    保持ログ番号 = 0
    保持ログパス = ""
    GoTo EndProc
    
EndProc:
End Sub

' =========================================================================
' 処理概要       : ログファイルを閉じる
' =========================================================================
Public Sub ログファイルを閉じる()
    If 保持ログ番号 = 0 Then Exit Sub
    
    On Error Resume Next
    Close #保持ログ番号
    On Error GoTo 0
    保持ログ番号 = 0
End Sub

' =========================================================================
' 処理概要       : ログファイルを再度開いて書き込み内容を確定
' =========================================================================
Public Sub ログファイルを再度開いて書き込み内容を確定()
    If 保持ログ番号 = 0 Then Exit Sub
    If Len(保持ログパス) = 0 Then Exit Sub
    
    On Error GoTo ErrorHanler
    Close #保持ログ番号
    保持ログ番号 = FreeFile
    Open 保持ログパス For Binary Access Write Shared As #保持ログ番号
    Seek #保持ログ番号, LOF(保持ログ番号) + 1
    Exit Sub
    
ErrorHanler:
    MsgBox "処理を完了できません。" & vbCrLf & Err.Description, vbExclamation, "ログ保存"
    
    保持ログ番号 = 0
    GoTo EndProc
    
EndProc:
End Sub

' =========================================================================
' 処理概要       : ログに時刻とレベルを付加してファイルへ記録
' 引数           : ログ引数 (Long) - 設定するログレベル
'                  ログメッセージ (String) - ログに記録する内容
' =========================================================================
Private Sub ログに時刻とレベルを付加してファイルへ記録(ByVal ログ引数 As Long, ByVal ログメッセージ As String)
    Dim ログ行 As String
    Dim ログ出力済み As String
    
    If Not 保持ログ初期化 Then ログ設定の既定値を初期化
    If ログ引数 > 保持ログレベル Then Exit Sub
    
    保持ログ連番 = 保持ログ連番 + 1
    
    ログ行 = Right$("00000" & CStr(保持ログ連番), 6) & " " & ミリ秒付きの現在時刻文字列を取得() & " [" & ログレベルに対応する表示名を取得(ログ引数) & "] " & ログメッセージ
    
    If 保持ログ階層数 > 0 Then
        保持ログ待機中 = 保持ログ待機中 & ログ行 & vbCrLf
        Exit Sub
    End If
    
    保持ログ階層数 = 保持ログ階層数 + 1
    On Error Resume Next
    
    If 保持ログ番号 = 0 Then 新しいログファイルを開く
    If 保持ログ番号 <> 0 Then
        バイト配列をログファイルへ書き込み 文字列をUTF8のバイト配列へ変換(ログ行 & vbCrLf)
        
        If Len(保持ログ待機中) > 0 Then
            ログ出力済み = 保持ログ待機中
            保持ログ待機中 = ""
            バイト配列をログファイルへ書き込み 文字列をUTF8のバイト配列へ変換(ログ出力済み)
        End If
    End If
    
    On Error GoTo 0
    保持ログ階層数 = 保持ログ階層数 - 1
    
    If ログ引数 <= 警告ログ Then ログファイルを再度開いて書き込み内容を確定
End Sub

' =========================================================================
' 処理概要       : バイト配列をログファイルへ書き込み
' 引数           : 出力バイト数 (Byte()) - ログに書き込むUTF-8バイト配列
' =========================================================================
Private Sub バイト配列をログファイルへ書き込み(ByRef 出力バイト数() As Byte)
    On Error Resume Next
    If 保持ログ番号 = 0 Then Exit Sub
    
    Put #保持ログ番号, , 出力バイト数
End Sub

' =========================================================================
' 処理概要       : ログレベルに対応する表示名を取得
' 引数           : ログ引数 (Long) - 設定するログレベル
' 戻り値         : String - ログレベルに対応する表示名
' =========================================================================
Private Function ログレベルに対応する表示名を取得(ByVal ログ引数 As Long) As String
    Select Case ログ引数
        Case エラーログ: ログレベルに対応する表示名を取得 = "ERR "
        Case 警告ログ:  ログレベルに対応する表示名を取得 = "WARN"
        Case 情報ログ:  ログレベルに対応する表示名を取得 = "INFO"
        Case Else:      ログレベルに対応する表示名を取得 = "DBG "
    End Select
End Function

' =========================================================================
' 処理概要       : ミリ秒付きの現在時刻文字列を取得
' 戻り値         : String - ミリ秒付きの現在時刻文字列
' =========================================================================
Private Function ミリ秒付きの現在時刻文字列を取得() As String
    Dim 作業情報 As 日時情報
    
    現在時刻取得API 作業情報
    
    ミリ秒付きの現在時刻文字列を取得 = Format$(作業情報.年, "0000") & "-" & Format$(作業情報.月, "00") & "-" & Format$(作業情報.日, "00") & " " & Format$(作業情報.時, "00") & ":" & Format$(作業情報.分, "00") & ":" & Format$(作業情報.秒, "00") & "." & _
        Format$(作業情報.ミリ秒, "000")
End Function

' =========================================================================
' 処理概要       : ログ保存先フォルダーを作成してパスを取得
' 戻り値         : String - ログ保存先フォルダーを作成してパス
' =========================================================================
Private Function ログ保存先フォルダーを作成してパスを取得() As String
    Dim フォルダー As String
    
    On Error GoTo ErrorHanler
    フォルダー = mod_WV2_共通設定.保存先フォルダー & "\logs"
    mod_WV2_ネイティブ連携.必要な保存先フォルダーを作成 フォルダー
    ログ保存先フォルダーを作成してパスを取得 = フォルダー & "\"
    Exit Function
    
ErrorHanler:
    MsgBox "処理を完了できません。" & vbCrLf & Err.Description, vbExclamation, "ログ保存先"
    ログ保存先フォルダーを作成してパスを取得 = ""
    GoTo EndProc
    
EndProc:
End Function

' =========================================================================
' 処理概要       : 保持件数を超えた古いログファイルを削除
' 引数           : ログフォルダー (String) - ログファイルの保存先フォルダー
' =========================================================================
Private Sub 保持件数を超えた古いログファイルを削除(ByVal ログフォルダー As String)
    Dim ログ名称一覧() As String
    Dim ログ件数 As Long
    Dim ログ名称 As String
    Dim ログ添字 As Long
    Dim ログ下限 As Long
    Dim ログ上限 As String
    Dim ログ保持対象 As Long
    
    On Error GoTo ErrorHanler
    
    ReDim ログ名称一覧(0 To 255)
    ログ件数 = 0
    
    ' 指定フォルダーから、このツールのログファイルだけを列挙する
    ログ名称 = Dir(ログフォルダー & ログファイル接頭辞 & "*.log")
    Do While Len(ログ名称) > 0
        If ログ件数 > UBound(ログ名称一覧) Then ReDim Preserve ログ名称一覧(0 To ログ件数 + 255)
        ログ名称一覧(ログ件数) = ログ名称
        ログ件数 = ログ件数 + 1
        ログ名称 = Dir
    Loop
    
    If ログ件数 <= ログ保持数 Then Exit Sub
    
    ' 日付を含むファイル名で古い順に並べ替える
    For ログ添字 = 1 To ログ件数 - 1
        ログ上限 = ログ名称一覧(ログ添字)
        ログ下限 = ログ添字 - 1
        Do While ログ下限 >= 0
            If ログ名称一覧(ログ下限) <= ログ上限 Then Exit Do
            ログ名称一覧(ログ下限 + 1) = ログ名称一覧(ログ下限)
            ログ下限 = ログ下限 - 1
        Loop
        ログ名称一覧(ログ下限 + 1) = ログ上限
    Next ログ添字
    
    ログ保持対象 = ログ件数 - ログ保持数
    
    ' 保持件数を超えた分だけ古いファイルを削除する
    For ログ添字 = 0 To ログ保持対象 - 1
        On Error Resume Next
        Kill ログフォルダー & ログ名称一覧(ログ添字)
        On Error GoTo 0
    Next ログ添字
    
    Exit Sub
    
ErrorHanler:
    MsgBox "処理を完了できません。" & vbCrLf & Err.Description, vbExclamation, "ログ整理"
    
    GoTo EndProc
    
EndProc:
End Sub

' =========================================================================
' 処理概要       : 文字列をUTF-8のバイト配列へ変換
' 引数           : ログ文字列 (String) - UTF-8へ変換する文字列
' 戻り値         : Byte() - UTF-8のバイト配列
' =========================================================================
Private Function 文字列をUTF8のバイト配列へ変換(ByVal ログ文字列 As String) As Byte()
    Dim 出力バイト数() As Byte
    Dim ログ長さ As Long
    Dim ログ添字 As Long
    Dim ログ件数 As Long
    Dim ログコード As Long
    Dim ログ下限 As Long
    
    ログ長さ = Len(ログ文字列)
    If ログ長さ = 0 Then
        ReDim 出力バイト数(0 To 0)
        文字列をUTF8のバイト配列へ変換 = 出力バイト数
        Exit Function
    End If
    
    ReDim 出力バイト数(0 To ログ長さ * 4 - 1)
    ログ件数 = 0
    ログ添字 = 1
    
    Do While ログ添字 <= ログ長さ
        ログコード = AscW(Mid$(ログ文字列, ログ添字, 1))
        
        If ログコード < 0 Then ログコード = ログコード + 65536
        
        If ログコード >= &HD800& And ログコード <= &HDBFF& And ログ添字 < ログ長さ Then
            ログ下限 = AscW(Mid$(ログ文字列, ログ添字 + 1, 1))
            If ログ下限 < 0 Then ログ下限 = ログ下限 + 65536
            If ログ下限 >= &HDC00& And ログ下限 <= &HDFFF& Then
                ログコード = &H10000 + (ログコード - &HD800&) * &H400 + (ログ下限 - &HDC00&)
                ログ添字 = ログ添字 + 1
            End If
        End If
        
        If ログコード < &H80 Then
            出力バイト数(ログ件数) = CByte(ログコード)
            ログ件数 = ログ件数 + 1
        ElseIf ログコード < &H800 Then
            出力バイト数(ログ件数) = CByte(&HC0 + (ログコード \ &H40))
            出力バイト数(ログ件数 + 1) = CByte(&H80 + (ログコード Mod &H40))
            ログ件数 = ログ件数 + 2
        ElseIf ログコード < &H10000 Then
            出力バイト数(ログ件数) = CByte(&HE0 + (ログコード \ &H1000))
            出力バイト数(ログ件数 + 1) = CByte(&H80 + ((ログコード \ &H40) Mod &H40))
            出力バイト数(ログ件数 + 2) = CByte(&H80 + (ログコード Mod &H40))
            ログ件数 = ログ件数 + 3
        Else
            出力バイト数(ログ件数) = CByte(&HF0 + (ログコード \ &H40000))
            出力バイト数(ログ件数 + 1) = CByte(&H80 + ((ログコード \ &H1000) Mod &H40))
            出力バイト数(ログ件数 + 2) = CByte(&H80 + ((ログコード \ &H40) Mod &H40))
            出力バイト数(ログ件数 + 3) = CByte(&H80 + (ログコード Mod &H40))
            ログ件数 = ログ件数 + 4
        End If
        
        ログ添字 = ログ添字 + 1
    Loop
    
    ReDim Preserve 出力バイト数(0 To ログ件数 - 1)
    文字列をUTF8のバイト配列へ変換 = 出力バイト数
End Function
