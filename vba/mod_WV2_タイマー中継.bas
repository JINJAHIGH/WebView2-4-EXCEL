Attribute VB_Name = "mod_WV2_タイマー中継"
Option Explicit

' -------------
' 定数
' -------------
Private Const 空ポインター As LongLong = 0^
Private Const ポインター長 As Long = 8

Private Enum 配列属性
    配列属性自動 = &H1
    配列属性固定長 = &H10
End Enum

Private Type 配列境界
    要素数 As Long
    下限値 As Long
End Type

Private Type 一次元配列情報
    次元数 As Integer
    属性値 As Integer
    要素バイト数 As Long
    ロック数 As Long
    データアドレス As LongPtr
    先頭次元境界 As 配列境界
End Type

Private Type ポインター参照情報
    参照配列() As LongPtr
    配列情報 As 一次元配列情報
End Type

' =========================================================================
' 処理概要       : ネイティブ呼び出しの中継先アドレスを確保
' =========================================================================
Private Sub ネイティブ中継入口(): End Sub

' =========================================================================
' 処理概要       : タイマー中継用の機械語領域を確保
' =========================================================================
Private Sub タイマー中継領域(): End Sub

' =========================================================================
' 処理概要       : 安全タイマーを呼び出すネイティブ中継関数のアドレスを取得
' 引数           : 作業情報 (mod_WV2_安全タイマー) - 中継先のタイマー
' 戻り値         : LongPtr - 対象のアドレス。取得できない場合 0
' =========================================================================
Public Function 安全タイマーの中継関数アドレスを取得(ByVal 作業情報 As mod_WV2_安全タイマー) As LongPtr
    Static ポインター参照 As ポインター参照情報
    Dim 中継先アドレス As LongPtr
    
    If 作業情報 Is Nothing Then Exit Function
    
    ' 初回だけ、ポインターを読み書きする配列記述子を設定する
    If ポインター参照.配列情報.次元数 = 0 Then
        ポインター参照.配列情報.次元数 = 1
        ポインター参照.配列情報.属性値 = 配列属性自動 Or 配列属性固定長
        ポインター参照.配列情報.要素バイト数 = ポインター長
        ポインター参照.配列情報.ロック数 = 1
        指定アドレスにポインター値を書き込み(VarPtr(ポインター参照)) = VarPtr(ポインター参照.配列情報)
    End If
    
    ポインター参照.配列情報.データアドレス = ObjPtr(作業情報)
    ポインター参照.配列情報.先頭次元境界.要素数 = 1
    
    安全タイマーの中継関数アドレスを取得 = VBA.Int(AddressOf ネイティブ中継入口)
    中継先アドレス = VBA.Int(AddressOf タイマー中継領域)
    ポインター参照.配列情報.データアドレス = 中継先アドレス
    
    ' 中継命令が未設定の場合は、所定の位置に命令を書き込む
    If (ポインター参照.参照配列(0) And &HFFFFFF) <> &HC1894C Then
                                  ポインター参照.参照配列(0) = &HC1894C
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 3:  ポインター参照.参照配列(0) = &H18B48
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 6:  ポインター参照.参照配列(0) = &H55&
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 7:  ポインター参照.参照配列(0) = &HEC8B48
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 10: ポインター参照.参照配列(0) = &H20EC8348
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 14: ポインター参照.参照配列(0) = &H4050FF
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 17: ポインター参照.参照配列(0) = &H20C48348
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 21: ポインター参照.参照配列(0) = &H5D&
        ポインター参照.配列情報.データアドレス = 中継先アドレス + 22: ポインター参照.参照配列(0) = &HC3&
    End If
    ポインター参照.配列情報.データアドレス = 安全タイマーの中継関数アドレスを取得 + 55
    ポインター参照.参照配列(0) = 中継先アドレス
    
    ' 配列から参照先アドレスを解除する
    ポインター参照.配列情報.先頭次元境界.要素数 = 0
    ポインター参照.配列情報.データアドレス = 空ポインター
End Function

' =========================================================================
' 処理概要       : 指定アドレスにポインター値を書き込み
' 引数           : アドレス (LongPtr) - 読み書きするメモリーアドレス
'                  新規値 (LongPtr) - 設定する値
' =========================================================================
Private Property Let 指定アドレスにポインター値を書き込み(ByVal アドレス As LongPtr, ByVal 新規値 As LongPtr)
    Dim ポインター参照(0 To 0) As ポインター参照情報
    
    With ポインター参照(0)
        .配列情報.次元数 = 1
        .配列情報.ロック数 = 1
        .配列情報.属性値 = 配列属性自動 Or 配列属性固定長
        .配列情報.データアドレス = アドレス
        .配列情報.先頭次元境界.要素数 = 1
        ポインター配列の先頭にアドレスを書き込み ポインター参照, VarPtr(.配列情報)
        .参照配列(0) = 新規値
        .配列情報.先頭次元境界.要素数 = 0
        .配列情報.データアドレス = 空ポインター
    End With
End Property

' =========================================================================
' 処理概要       : ポインター配列の先頭にアドレスを書き込み
' 引数           : ポインター配列 (LongPtr()) - 書き込み対象のポインター配列
'                  書込ポインター (LongPtr) - 書き込むポインター値
' =========================================================================
Private Sub ポインター配列の先頭にアドレスを書き込み(ByRef ポインター配列() As LONG_PTR, ByVal 書込ポインター As LongPtr)
    ポインター配列(0) = 書込ポインター
End Sub
