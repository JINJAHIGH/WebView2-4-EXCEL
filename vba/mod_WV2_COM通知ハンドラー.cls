VERSION 1.0 CLASS
BEGIN
  MultiUse = -1
END
Attribute VB_Name = "mod_WV2_COM通知ハンドラー"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Option Explicit

Private 保持種別     As 通知区分
Private 保持所有元    As Object
Private 保持ポインタースロット    As LongPtr
Private 保持参照件数 As Long

Private 保持通知識別番号 As Long

' =========================================================================
' 処理概要       : ハンドラーの種別と通知先を設定
' 引数           : 通知種別 (通知区分) - コールバックまたはイベントの種別
'                  所有元 (Object) - コールバックを通知する所有元
'                  ポインタースロット (LongPtr) - 中継スロットの先頭アドレス
' =========================================================================
Friend Sub 初期化(ByVal 通知種別 As 通知区分, ByVal 所有元 As Object, ByVal ポインタースロット As LongPtr)
    保持種別 = 通知種別
    Set 保持所有元 = 所有元
    保持ポインタースロット = ポインタースロット
    保持参照件数 = 0
End Sub

' =========================================================================
' 処理概要       : COM参照カウントを取得
' 戻り値         : Long - COM参照カウント
' =========================================================================
Friend Property Get 参照数() As Long
    参照数 = 保持参照件数
End Property

' =========================================================================
' 処理概要       : COM参照カウントを設定
' 引数           : 処理値 (Long) - 設定する参照カウント
' =========================================================================
Friend Property Let 参照数(ByVal 処理値 As Long)
    保持参照件数 = 処理値
End Property

' =========================================================================
' 処理概要       : 割り当て済みハンドラースロットのアドレスを取得
' 戻り値         : LongPtr - 対象のアドレス。取得できない場合 0
' =========================================================================
Friend Property Get スロットアドレス() As LongPtr
    スロットアドレス = 保持ポインタースロット
End Property

' =========================================================================
' 処理概要       : コールバックの種別を取得
' 戻り値         : 通知区分 - コールバックの種別
' =========================================================================
Friend Property Get 通知種別() As 通知区分
    通知種別 = 保持種別
End Property

' =========================================================================
' 処理概要       : 非同期処理を識別するIDを取得
' 戻り値         : Long - 非同期処理を識別するID
' =========================================================================
Friend Property Get 通知識別番号() As Long
    通知識別番号 = 保持通知識別番号
End Property

' =========================================================================
' 処理概要       : 非同期処理を識別するIDを設定
' 引数           : 処理値 (Long) - 設定する非同期処理の識別ID
' =========================================================================
Friend Property Let 通知識別番号(ByVal 処理値 As Long)
    保持通知識別番号 = 処理値
End Property

' =========================================================================
' 処理概要       : 通知先オブジェクトへの参照を解除
' =========================================================================
Friend Sub 通知先オブジェクトへの参照を解除()
    Set 保持所有元 = Nothing
End Sub

' =========================================================================
' 処理概要       : コールバックの種別に応じて所有元へ処理を通知
' 引数           : 呼出元アドレス (LongPtr) - 呼び出された中継COMオブジェクトのアドレス
'                  引数1 (LongPtr) - コールバックの第1ネイティブ引数
'                  引数2 (LongPtr) - コールバックの第2ネイティブ引数
' 戻り値         : Long - HRESULT（成功時 0 / 失敗時はエラーコード）
' =========================================================================
Public Function コールバックの種別に応じて所有元へ処理を通知(ByVal 呼出元アドレス As LongPtr, ByVal 引数1 As LongPtr, ByVal 引数2 As LongPtr) As Long
    Dim エラーコード As Long
    Dim エラーコード2 As Long
    Dim エラーコード4 As Long
    Dim エラーコード3 As Long
    Dim 結果文字列 As String
    
    ' -------------
    ' コールバックの引数を通知先のメソッドへ引き渡し
    ' -------------
    Select Case 保持種別
        Case 環境生成完了通知
            エラーコード = ポインター値の下位32ビットを符号付き整数として取得(引数1)
            
            If Not (保持所有元 Is Nothing) Then
                保持所有元.環境の生成結果を保持して初期化状態を更新 エラーコード, 引数2
            End If
            
        Case 表示生成完了通知
            エラーコード2 = ポインター値の下位32ビットを符号付き整数として取得(引数1)
            
            If Not (保持所有元 Is Nothing) Then
                保持所有元.コントローラーの生成結果を保持して状態を更新 エラーコード2, 引数2
            End If
            
        Case 遷移開始通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.ページ遷移開始イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case 遷移完了通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.ページ遷移完了イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case Webメッセージ通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.Webメッセージ受信イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case タイトル変更通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.ページタイトル変更イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case 新規ウィンドウ通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.新規ウィンドウ要求イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case 履歴変更通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.履歴変更イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case DOM読込通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.DOM読み込み完了イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case 通信要求通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.通信要求イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case 通信応答通知
        
            If Not (保持所有元 Is Nothing) Then
                保持所有元.通信応答イベントを受け付けてコールバック状態を管理 引数1, 引数2
            End If
            
        Case 応答本文取得通知
        
            エラーコード4 = ポインター値の下位32ビットを符号付き整数として取得(引数1)
            
            If Not (保持所有元 Is Nothing) Then
                保持所有元.応答本文の取得結果を受け付けてコールバック状態を管理 保持通知識別番号, エラーコード4, 引数2
            End If
            
        Case スクリプト完了通知
        
            エラーコード3 = ポインター値の下位32ビットを符号付き整数として取得(引数1)
            If 引数2 <> 0 Then
                結果文字列 = UTF16文字列ポインターをVBA文字列へ変換(引数2)
            End If
            
            If Not (保持所有元 Is Nothing) Then
                保持所有元.非同期JavaScriptの結果を待機中の処理またはフォームへ通知 保持通知識別番号, エラーコード3, 結果文字列
            End If
            
        Case Else
        
    End Select
    
    コールバックの種別に応じて所有元へ処理を通知 = 0
End Function

' =========================================================================
' 処理概要       : ポインター値の下位32ビットを符号付き整数として取得
' 引数           : 処理値 (LongPtr) - 設定する非同期処理の識別ID
' 戻り値         : Long - 下位32ビットの符号付き整数値
' =========================================================================
Private Function ポインター値の下位32ビットを符号付き整数として取得(ByVal 処理値 As LongPtr) As Long
    Dim 対象URL As LongLong
    
    対象URL = 処理値 And &HFFFFFFFF^
    If 対象URL >= &H80000000^ Then
        ポインター値の下位32ビットを符号付き整数として取得 = CLng(対象URL - &H100000000^)
    Else
        ポインター値の下位32ビットを符号付き整数として取得 = CLng(対象URL)
    End If
End Function
